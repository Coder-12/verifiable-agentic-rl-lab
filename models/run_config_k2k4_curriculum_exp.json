{
  "model": "Qwen/Qwen2.5-1.5B-Instruct",
  "train_samples": 2000,
  "output_dir": "models/Qwen2.5-1.5B-GRPO-k3k4-step200-seed42",
  "seed": 42,
  "optimizer": "adamw_torch",
  "torch_dtype": "torch.float16",
  "bf16": false,
  "fp16": true,
  "reward_mapping": {
    "correct": 1.0,
    "wrong_value": 0.3,
    "wrong_numbers": 0.05,
    "empty_expression": 0.0,
    "parse_error": 0.0,
    "unsafe_expression": 0.0,
    "division_by_zero": 0.0
  },
  "dataset_config": {
    "min_numbers": 3,
    "max_numbers": 4,
    "balanced_by_k": true,
    "k_distribution": {
      "3": 1000,
      "4": 1000
    }
  },
  "hyperparameters": {
    "max_steps": 200,
    "learning_rate": 5e-06,
    "warmup_ratio": 0.1,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 4,
    "num_generations": 4,
    "max_completion_length": 128,
    "temperature": 0.7,
    "top_p": 0.95,
    "save_steps": 200,
    "save_total_limit": 1
  },
  "environment": {
    "python": "3.12.13",
    "torch": "2.10.0+cu128",
    "transformers": "5.0.0"
  },
  "command": {
    "argv": [
      "scripts/train_grpo_countdown.py",
      "--model",
      "Qwen/Qwen2.5-1.5B-Instruct",
      "--train-samples",
      "2000",
      "--output-dir",
      "models/Qwen2.5-1.5B-GRPO-k3k4-step200-seed42",
      "--max-steps",
      "200",
      "--seed",
      "42",
      "--max-completion-length",
      "128",
      "--min-numbers",
      "3",
      "--max-numbers",
      "4",
      "--balanced-by-k"
    ]
  }
}